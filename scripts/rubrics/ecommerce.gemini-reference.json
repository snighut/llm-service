        ["cart", "order"],
        ["checkout"],
        ["fetch"]
      ]
    },
    {
      "key": "search_capability",
      "description": "Design includes search indexing/capability",
      "componentAnyOf": [
        ["elasticsearch"],
        ["search", "engine"],
        ["search"]
      ],
      "contextAnyOf": [
        ["full-text", "search"],
        ["browse", "products"]
      ]
    },
    {
      "key": "distributed_transaction",
      "description": "Design includes saga/distributed transaction orchestration",
      "componentAnyOf": [
        ["saga", "orchestrator"],
        ["orchestrator"]
      ],
      "connectionAnyOf": [
        ["orchestration", "flow"],
        ["saga", "pattern"],
        ["control", "flow"]
      ]
    },
    {
      "key": "payment_notification_integrations",
      "description": "Design references payment and notification integration concerns",
      "contextAnyOf": [
        ["stripe"],
        ["paypal"],
        ["sendgrid"],
        ["payment"],
        ["notification"]
      ]
    }
